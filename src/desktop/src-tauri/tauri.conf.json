{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "无尽布阵工具v4",
  "mainBinaryName": "wujin-bz-v4",
  "version": "4.0.7",
  "identifier": "com.mpz.wujinbz.v3beta",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "无尽布阵工具 v4",
        "width": 1500,
        "height": 940,
        "minWidth": 1120,
        "minHeight": 700,
        "center": true,
        "decorations": false,
        "dragDropEnabled": false,
        "backgroundColor": "#0a0e16"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "shortDescription": "无尽布阵工具 v3（布阵 + Agent 工作台）",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
